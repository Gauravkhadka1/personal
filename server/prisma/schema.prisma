generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-1.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  userId              Int       @id @default(autoincrement())
  firstname           String? 
  lastname            String? 
  phone               String? 
  email               String    @unique
  profilePictureUrl   String?
  password            String
  role                Role      @default(USER)
  failedLoginAttempts   Int                   @default(0)
  lastLogin             DateTime?
  accountLockedUntil    DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime? @updatedAt

  earnedIncomes     EarnedIncome[]
  passiveIncomes    PassiveIncome[]
  expenseCategories ExpenseCategory[]  
  assets            Asset[]
  liabilities       Liability[]
  dailyExpenses     DailyExpense[]     
  workoutDays       WorkoutDay[]       
  workoutLogs       WorkoutLog[]       
  lessons           Lesson[]           
}

enum Role {
  ADMIN
  USER
}

// Earned Income
model EarnedIncome {
  id        String   @id @default(cuid())
  name      String
  amount    Float
  userId    Int
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
    date        DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Passive Income
model PassiveIncome {
  id        String   @id @default(cuid())
  name      String
  amount    Float
  userId    Int
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
    date        DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Expense Category (formerly Expense)
model ExpenseCategory {
  id            String          @id @default(cuid())
  name          String
  amount        Float
  userId        Int
  user          User            @relation(fields: [userId], references: [userId], onDelete: Cascade)
  dailyExpenses DailyExpense[]  // Add this line
    date        DateTime
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

// Assets
model Asset {
  id     String @id @default(cuid())
  name   String
  value  Float
  userId Int
  user   User   @relation(fields: [userId], references: [userId], onDelete: Cascade)
    date        DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Liabilities
model Liability {
  id     String @id @default(cuid())
  name   String
  value  Float
  userId Int
  user   User   @relation(fields: [userId], references: [userId], onDelete: Cascade)
    date        DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DailyExpense {
  id                String          @id @default(cuid())
  description       String
  amount            Float
  date              DateTime
  expenseCategoryId String
  expenseCategory   ExpenseCategory @relation(fields: [expenseCategoryId], references: [id], onDelete: Cascade)
  userId            Int
  user              User            @relation(fields: [userId], references: [userId], onDelete: Cascade)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}


model WorkoutDay {
  id        String   @id @default(cuid())
  dayName   String
  userId    Int
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  exercises WorkoutExercise[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, dayName]) 
}

model WorkoutExercise {
  id            String   @id @default(cuid())
  name          String
  muscleGroup   String   // Chest, Tricep, Back, Bicep, Shoulder, Leg, Abs, etc.
  defaultSets   Int      @default(3)
  defaultReps   Int      @default(10)
  defaultWeight Float    @default(0)
  workoutDayId  String
  workoutDay    WorkoutDay @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)
  workoutLogs   WorkoutLog[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WorkoutLog {
  id              String   @id @default(cuid())
  date            DateTime
  sets            Int
  reps            Int
  weight          Float
  completed       Boolean  @default(false)
  notes           String?
  exerciseId      String
  exercise        WorkoutExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  userId          Int
  user            User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LessonCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lessons     Lesson[]

  @@map("lesson_categories")
}

model Lesson {
  id          String   @id @default(cuid())
  title       String
  content     String?   // For text content
  contentType  LessonContentType @default(TEXT)
  imageUrl    String?   // For image URL
  categoryId  String
  category    LessonCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userId      Int
  user        User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("lessons")
}

enum LessonContentType {
  TEXT
  IMAGE
  TEXT_IMAGE
}