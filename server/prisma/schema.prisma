// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-1.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  userId              Int       @id @default(autoincrement())
  firstname           String? // Made nullable
  lastname            String? // Made nullable
  phone               String? // Made nullable
  email               String    @unique
  profilePictureUrl   String?
  password            String
  role                Role      @default(USER)
  failedLoginAttempts   Int                   @default(0)
  lastLogin             DateTime?
  accountLockedUntil    DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime? @updatedAt

  earnedIncomes     EarnedIncome[]
  passiveIncomes    PassiveIncome[]
  expenseCategories ExpenseCategory[]  // Changed from expenses to expenseCategories
  assets            Asset[]
  liabilities       Liability[]
  dailyExpenses     DailyExpense[]     // Add this line
  workoutDays       WorkoutDay[]       // Add this line
  workoutLogs       WorkoutLog[]       // Add this line
}

enum Role {
  ADMIN
  USER
}

// Earned Income
model EarnedIncome {
  id        String   @id @default(cuid())
  name      String
  amount    Float
  userId    Int
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
    date        DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Passive Income
model PassiveIncome {
  id        String   @id @default(cuid())
  name      String
  amount    Float
  userId    Int
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
    date        DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Expense Category (formerly Expense)
model ExpenseCategory {
  id            String          @id @default(cuid())
  name          String
  amount        Float
  userId        Int
  user          User            @relation(fields: [userId], references: [userId], onDelete: Cascade)
  dailyExpenses DailyExpense[]  // Add this line
    date        DateTime
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

// Assets
model Asset {
  id     String @id @default(cuid())
  name   String
  value  Float
  userId Int
  user   User   @relation(fields: [userId], references: [userId], onDelete: Cascade)
    date        DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Liabilities
model Liability {
  id     String @id @default(cuid())
  name   String
  value  Float
  userId Int
  user   User   @relation(fields: [userId], references: [userId], onDelete: Cascade)
    date        DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DailyExpense {
  id                String          @id @default(cuid())
  description       String
  amount            Float
  date              DateTime
  expenseCategoryId String
  expenseCategory   ExpenseCategory @relation(fields: [expenseCategoryId], references: [id], onDelete: Cascade)
  userId            Int
  user              User            @relation(fields: [userId], references: [userId], onDelete: Cascade)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}


model WorkoutDay {
  id        String   @id @default(cuid())
  dayName   String
  userId    Int
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  exercises WorkoutExercise[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, dayName]) // Each user can have one workout per day
}

model WorkoutExercise {
  id            String   @id @default(cuid())
  name          String
  muscleGroup   String   // Chest, Tricep, Back, Bicep, Shoulder, Leg, Abs, etc.
  defaultSets   Int      @default(3)
  defaultReps   Int      @default(10)
  defaultWeight Float    @default(0)
  workoutDayId  String
  workoutDay    WorkoutDay @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)
  workoutLogs   WorkoutLog[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WorkoutLog {
  id              String   @id @default(cuid())
  date            DateTime
  sets            Int
  reps            Int
  weight          Float
  completed       Boolean  @default(false)
  notes           String?
  exerciseId      String
  exercise        WorkoutExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  userId          Int
  user            User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}